{
  "name": "@rescuebase/react-native-tourguide",
  "version": "1.0.0-alpha.2",
  "description": "Make an interactive step by step tour guide for your react-native app (a rewrite of react-native-copilot)",
  "main": "node_modules/expo/AppEntry.js",
  "types": "lib/index.d.ts",
  "private": false,
  "scripts": {
    "start": "yarn config:dev && expo start -c",
    "start:web": "yarn config:dev && expo start -c -w",
    "test": "TZ=Europe/Paris jest --no-watchman",
    "tsc": "node_modules/.bin/tsc --noEmit",
    "tsc:watch": "node_modules/.bin/tsc --noEmit --watch",
    "build": "rm -rf lib/ && node_modules/.bin/tsc",
    "config:dev": "json -I -f package.json -e 'this.main=\"node_modules/expo/AppEntry.js\"'",
    "config:npm": "json -I -f package.json -e 'this.main=\"lib/index.js\"'",
    "lint": "tslint --project .",
    "verify": "yarn test && yarn lint && yarn tsc && yarn build",
    "prepublishOnly": "yarn verify && yarn config:npm",
    "postpublish": "yarn config:dev",
    "cleaning": "rm -rf node_modules && rm -f yarn.lock && yarn cache clean && yarn install && watchman watch-del-all && rm -fr $TMPDIR/react-*",
    "deploy": "gh-pages -d web-build",
    "predeploy": "yarn verify && expo build:web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanstinator/rn-tourguide.git"
  },
  "keywords": [
    "react-native",
    "react-native-joyride",
    "react",
    "copilot",
    "intro.js",
    "intro"
  ],
  "author": "Justin Vanderhooft <justin@vanderhooft.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vanstinator/react-native-tourguide/issues"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/lodash.clamp": "4.0.9",
    "@types/react": "~19.1.3",
    "babel-preset-expo": "~13.1.11",
    "expo": "^53.0.8",
    "gh-pages": "6.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.5",
    "jest-react-native": "^18.0.0",
    "json": "^11.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.79.2",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-test-renderer": ">=16.8.0",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "globals": {
      "__TEST__": true
    }
  },
  "dependencies": {
    "flubber": "~0.4.2",
    "hoist-non-react-statics": "~3.3.2",
    "lodash.clamp": "~4.0.3",
    "mem": "^10.0.0",
    "memoize-one": "6.0.0",
    "mitt": "~3.0.1",
    "react-native-safe-area-context": "^5.4.0"
  },
  "resolutions": {
    "logkitty": "^0.7.1",
    "mem": "^4.0.0",
    "set-value": "^4.0.1"
  }
}
